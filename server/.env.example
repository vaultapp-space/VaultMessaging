# Copy to .env and fill in real values. Never commit the actual .env file.

NODE_ENV=development

PORT=3001
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173

# Generate strong random values for these two in production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
TURN_SECRET=change-me

TURN_SERVER=stun.l.google.com:19302
TURN_CREDENTIAL_TTL=300

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=vault
PGPASSWORD=change-me
PGDATABASE=vault

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

REAPER_INTERVAL_MS=60000
