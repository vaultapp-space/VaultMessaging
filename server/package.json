{
  "name": "vault-server",
  "version": "1.0.0",
  "description": "Vault — Privacy-first anonymous messaging backend",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node scripts/migrate.js",
    "migrate:up": "node scripts/migrate.js up",
    "migrate:down": "node scripts/migrate.js down",
    "migrate:create": "node scripts/migrate.js create",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 --test-force-exit test/**/*.test.js",
    "lint": "eslint .",
    "e2e:server": "node scripts/e2e-server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/websocket": "^11.0.2",
    "argon2": "^0.41.1",
    "fastify": "^5.3.3",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "pino-pretty": "^13.1.3",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7"
  },
  "allowScripts": {
    "argon2@0.41.1": true
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.9.0",
    "node-pg-migrate": "^9.0.0",
    "ws": "^8.21.2"
  }
}
