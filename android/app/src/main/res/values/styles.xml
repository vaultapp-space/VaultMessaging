<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme.

         DayNight, not Light. This was Theme.AppCompat.Light.DarkActionBar —
         a hard-coded light theme — which is what put a white window behind
         the WebView on every device, dark mode included, and produced a
         white flash between the splash and the WebView's first paint. The
         WebView paints its own background moments later, so the flash was
         brief, but it was there on every cold start. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <!-- Resolves per values/ vs values-night/, so the frame behind the
             web content tracks the system theme rather than always being
             white. -->
        <item name="android:windowBackground">@color/vaultWindowBackground</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/vaultWindowBackground</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <!-- Hands the Activity off to the real app theme once the splash is
             done. Without this the launch theme stays applied for the life of
             the Activity, so the window kept whatever background the splash
             drawable had rather than the theme's. -->
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
