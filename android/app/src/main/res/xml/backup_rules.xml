<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below (API < 31) equivalent of data_extraction_rules.xml.
  Redundant while android:allowBackup="false" is set — that alone is enough to
  stop backup on these releases — but referenced from the manifest anyway so
  the opt-out survives someone flipping allowBackup back on without reading
  why it was off. minSdkVersion is 24 (android/variables.gradle), so this
  range is real, not legacy padding.

  See data_extraction_rules.xml for what is being protected and why.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
