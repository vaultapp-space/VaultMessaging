node_modules/
.DS_Store
dist/
build/
.env
.agents/
.system_generated/
*.log
vps_key.pem
promotional_materials/
backups/


# Playwright
test-results/
playwright-report/

# Runtime uploads: user content, never source.
server/uploads/

# Android (android/) — Capacitor's native project is plain Gradle/XML/Kotlin
# and is meant to be committed and hand-edited, unlike ios/.xcodeproj. Only
# its build artifacts and machine-local settings are excluded.
android_release.keystore
android_release.keystore.CREDENTIALS.txt
android/local.properties
android/.gradle/
android/build/
android/app/build/
android/captures/
# npx cap sync copies client/dist in here on every sync — a derived artifact
# of an already-gitignored dist/, not source.
android/app/src/main/assets/public/

# Self-hosted F-Droid repo (deploy/fdroid/). config.yml and keystore.p12 hold
# the repo INDEX signing key + its password in plaintext (a separate key from
# android_release.keystore, which signs the APK itself — F-Droid repos sign
# the index and the APKs independently). repo/, archive/, tmp/, stats/ and
# .fdroid/ are fdroidserver's generated output (index files, icons, the APK
# copy) — built locally and deployed straight to the VPS, never committed,
# same treatment as dist/. See deploy/fdroid/config.yml.example for the
# non-secret settings that DO need to be reproduced in a fresh config.yml.
deploy/fdroid/keystore.p12
deploy/fdroid/config.yml
deploy/fdroid/repo/
deploy/fdroid/archive/
deploy/fdroid/tmp/
deploy/fdroid/stats/
deploy/fdroid/logs/
deploy/fdroid/.fdroid/
